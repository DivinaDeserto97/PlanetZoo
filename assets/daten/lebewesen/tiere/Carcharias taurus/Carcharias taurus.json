      "zh-Hans": [""]
    },
    "tierfakten": {
      "de": [
        {
          "inhalt": "Sandtigerhaie sind trotz ihrer auffälligen Zähne meist eher ruhige Schwimmer.",
          "quelle": "planetZoo2"
        },
        {
          "inhalt": "Ihre Embryonen betreiben Adelphophagie, also das Fressen von Geschwisterembryonen.",
          "quelle": "planetZoo2"
        },
        {
          "inhalt": "Sandtigerhaie können Luft an der Oberfläche schlucken und damit ihren Auftrieb beeinflussen.",
          "quelle": "planetZoo2"
        },
        {
          "inhalt": "Jungtiere bilden in geschützten Bereichen gelegentlich Kinderstuben.",
          "quelle": "planetZoo2"
        }
      ],
