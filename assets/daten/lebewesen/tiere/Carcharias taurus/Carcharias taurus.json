    },
    "sozialverhaltenUndFortpflanzung": {
      "de": [
        {
          "inhalt": "Sandtigerhaie bilden wechselnde soziale Gruppen und versammeln sich zur Paarung. Männchen konkurrieren in der Fortpflanzungszeit um Weibchen. Nach rund neun Monaten Tragzeit werden nur ein bis zwei lebende Jungtiere geboren, weil die grössten Embryonen ihre Geschwister im Mutterleib fressen. Die Jungtiere leben sofort selbstständig.",
          "quelle": "planetZoo2"
        }
      ],
      "en": [""],
      "en-US": [""],
      "es": [""],
      "fr": [""],
      "it": [""],
      "pt-BR": [""],
