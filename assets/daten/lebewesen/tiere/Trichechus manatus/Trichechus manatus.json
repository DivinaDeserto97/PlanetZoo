    "tierfakten": {
      "de": [
        {
          "inhalt": "Karibik-Manatis werden in manchen Sprachen aufgrund ihrer langsamen Bewegungen und ihrer pflanzlichen Ernährung umgangssprachlich als „Seekühe“ bezeichnet.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Die Zähne des Karibik-Manatis wachsen immer weiter und werden von hinten ersetzt, wenn die vorderen beim Grasen abgenutzt sind.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Die nächsten lebenden Verwandten der Manatis sind Elefanten.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Manatis kommunizieren durch Trillern und Zwitschern, vor allem Mütter und ihre Kälber.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Früher haben Seefahrer Manatis für Meerjungfrauen gehalten. Christoph Kolumbus schrieb, dass die Manatis oder „Meerjungfrauen“, die er gesehen hat, „nicht halb so schön waren, wie sie gemalt werden“.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        }
