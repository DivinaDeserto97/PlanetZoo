    "tierfakten": {
      "de": [
        {
          "inhalt": "Die Klasse wird zwar als „Hundertfüßer“ bezeichnet, aber die Riesenläufer besitzen immer nur ein Beinpaar pro Körpersegment – in der Regel sind es 21 oder 23 Körpersegmente.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Der Brasilianische Riesenläufer atmet, genau wie seine Artverwandten, durch Löcher an der Seite seiner Körpersegmente.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Der Biss und das Gift des Brasilianischen Riesenläufers sind bisher nur für einen bestätigten Todesfall beim Menschen verantwortlich.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Der Brasilianische Riesenläufer wird jedes Tier fressen, das er fangen und töten kann, einschließlich Vogelspinnen und kleinen Schlangen.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
        },
        {
          "inhalt": "Es ist bekannt, dass sich Brasilianische Riesenläufer gelegentlich an die Decke von Höhlen hängen, um Fledermäuse zu fangen.",
          "quelle": "planetZoo2",
          "uebersetzung": ""
